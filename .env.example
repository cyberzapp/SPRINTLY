# Sprintly Environment Configuration Template
# Copy this file to .env.local and populate with your Firebase Project values.

# -----------------------------------------------------------------------------
# Firebase Public Web Configuration
# Obtained from: Firebase Console -> Project Settings -> General -> Your apps -> Web
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# -----------------------------------------------------------------------------
# Optional Firebase Emulators (Local Development)
# Set to true when running 'firebase emulators:start'
# -----------------------------------------------------------------------------
NEXT_PUBLIC_USE_FIREBASE_EMULATORS="false"
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST="127.0.0.1"

# -----------------------------------------------------------------------------
# Firebase Functions Region
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION="us-central1"

# -----------------------------------------------------------------------------
# Application URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Optional: Firebase App Check (reCAPTCHA Enterprise)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=""
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=""

# -----------------------------------------------------------------------------
# Optional: Web Push (FCM VAPID Key)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# -----------------------------------------------------------------------------
# Analytics Opt-in
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS="false"

# -----------------------------------------------------------------------------
# Google Cloud Vertex AI Configuration (Exclusively Used)
# -----------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI="true"
GOOGLE_CLOUD_PROJECT="sprintly-si"
GOOGLE_CLOUD_LOCATION="us-central1"
VERTEX_AI_API_KEY=""
GEMINI_API_KEY=""
